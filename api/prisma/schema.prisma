generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id        Int      @id @default(autoincrement())
  company   String
  contact   String?
  country   String?
  location  String?
  tin       String?
  currency  String   @default("RWF")
  logo      String?  // per-client branding logo (uploads/ filename); platform logo otherwise
  status    String   @default("TRIAL") // TRIAL | ACTIVE | SUSPENDED | TERMINATED
  trialEndsAt DateTime?
  plan      String?  // STARTER | PRO | ENTERPRISE (null until first subscription)
  paidUntil DateTime? // subscription covered through this date
  settings  Json?
  createdAt DateTime @default(now())

  users     User[]
  projects  Project[]
  stock     StockItem[]
  requests  StockRequest[]
  damaged   DamagedItem[]
  messages  Message[]
  audit     AuditLog[]
  updates   DailyUpdate[]
  workers   Worker[]
  attendanceSessions AttendanceSession[]
  cardIssues CardIssue[]
  payments  Payment[]
  stockIssues StockIssue[]
  stockReturns StockReturn[]
  stockStores StockStore[]
  stockTransfers StockTransfer[]
}

// Manual MoMo subscription payments: the client creates a payment intent at
// checkout, sends the money by phone, submits the payer number, and the
// platform Super Admin confirms receipt (a payment-provider API can replace
// the manual confirm later).
model Payment {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  plan        String   // STARTER | PRO
  months      Int      @default(1)
  amount      Int
  currency    String   @default("RWF")
  reference   String   @unique // shown in the MoMo transfer note, e.g. BR-7K2M4Q
  method      String   @default("momo")
  payerPhone  String?
  status      String   @default("PENDING") // PENDING | CONFIRMED | REJECTED | CANCELED
  submittedAt DateTime? // when the client said "I sent the money"
  confirmedAt DateTime?
  confirmedBy String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@index([status])
}

model User {
  id           Int      @id @default(autoincrement())
  clientId     Int?
  client       Client?  @relation(fields: [clientId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         String   // SUPER | CLIENT | SENIOR | SITE | STOCK | GUEST
  language     String   @default("en") // en | fr | rw
  photo        String?  // optional profile photo (uploads/ filename); initials otherwise
  cardId       String?  @unique // QR badge id, auto-generated at creation - attendance + stock issues
  suspended    Boolean  @default(false) // suspended members cannot log in or act
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  backupCodes  Json? // sha256 hashes of unused one-time backup codes
  // Tokens issued before this moment are rejected: set on every password
  // change/reset so a stolen session dies the moment the password changes.
  sessionsValidFrom DateTime?
  createdAt    DateTime @default(now())

  updates      DailyUpdate[]
  messages     Message[]
  requests     StockRequest[]
  resetTokens  ResetToken[]
  phases       Phase[]  @relation("assignee")
  documents    Document[]
  memberships  ProjectMember[]
  stockIssued   StockIssue[] @relation("stockIssuer")
  stockReceived StockIssue[] @relation("stockReceiver")
  stockTaken    StockReturn[] @relation("stockReturnTaker")
  stockReturned StockReturn[] @relation("stockReturner")
  cardIssues    CardIssue[]
  attendance    AttendanceRecord[]
  managedStores StockStore[] @relation("StoreManager")
  stockTransfers StockTransfer[]

  @@index([clientId])
}

model ResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
}

model Project {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  location  String?
  status    String   @default("Planning") // Planning | In progress | Done
  currency  String   @default("RWF")
  budget    Int      @default(0)
  documents Json?
  createdAt DateTime @default(now())

  phases    Phase[]
  updates   DailyUpdate[]
  attendanceSessions AttendanceSession[]
  members   ProjectMember[]
  stock     StockItem[]
  stockRequests StockRequest[]
  damaged   DamagedItem[]
  workers   Worker[]
  stores    StockStore[]

  @@index([clientId])
}

// Project-scoped team: each project has its own senior/site engineers, stock
// manager and guests. Non-admin users see ONLY their assigned projects' data -
// someone assigned to nothing sees no projects until the admin assigns them.
model ProjectMember {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Phase {
  id            Int      @id @default(autoincrement())
  projectId     Int
  project       Project  @relation(fields: [projectId], references: [id])
  name          String
  status        String   @default("todo") // todo | active | done
  percent       Int      @default(0)
  startDate     DateTime?
  endDate       DateTime?
  budget        Int      @default(0)
  costPerBuilder Int     @default(0)
  costPerHelper  Int     @default(0)
  signedOffAt   DateTime? // set when the phase is marked done; cleared on reopen
  signedOffBy   String?
  assigneeId    Int?
  assignee      User?    @relation("assignee", fields: [assigneeId], references: [id])
  orderIdx      Int      @default(0)
  createdAt     DateTime @default(now())

  materials     PhaseMaterial[]
  updates       DailyUpdate[]
  insights      KeyInsight[]
  attendanceSessions AttendanceSession[]

  @@index([projectId])
}

model KeyInsight {
  id        Int       @id @default(autoincrement())
  phaseId   Int
  phase     Phase     @relation(fields: [phaseId], references: [id])
  title     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneBy    String?
  media     Json? // proof attachments: [{ kind, path, name }]
  orderIdx  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([phaseId])
}

model PhaseMaterial {
  id           Int       @id @default(autoincrement())
  phaseId      Int
  phase        Phase     @relation(fields: [phaseId], references: [id])
  stockItemId  Int
  stockItem    StockItem @relation(fields: [stockItemId], references: [id])
  nameSnap     String
  qty          Int
  unitCostSnap Int
  createdAt    DateTime  @default(now())

  @@index([phaseId])
}

// crew: [{ type, count }] - worker types on site that day, pulled from the
// attendance feature automatically (plus manual additions). builders/helpers
// stay as legacy rollups (helper types → helpers, everything else → builders)
// so the cost model keeps working unchanged.
model DailyUpdate {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  phaseId   Int?
  phase     Phase?   @relation(fields: [phaseId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  builders  Int      @default(0)
  helpers   Int      @default(0)
  crew      Json?    // [{ type, count }] per worker type on site
  note      String?  @db.Text
  geotag    String?
  forwarded Boolean  @default(false)
  createdAt DateTime @default(now())

  media     Media[]
  materials UpdateMaterial[]

  @@index([clientId])
  @@index([phaseId])
}

// Items reported as used in a daily update. Quantities are deducted from
// stock on submit; name/unit/cost are snapshotted so the report stays true
// even if the stock item is later edited.
model UpdateMaterial {
  id           Int         @id @default(autoincrement())
  updateId     Int
  update       DailyUpdate @relation(fields: [updateId], references: [id])
  stockItemId  Int
  stockItem    StockItem   @relation(fields: [stockItemId], references: [id])
  nameSnap     String
  unitSnap     String      @default("pcs")
  qty          Int
  unitCostSnap Int
  createdAt    DateTime    @default(now())

  @@index([updateId])
}

model Media {
  id       Int         @id @default(autoincrement())
  updateId Int
  update   DailyUpdate @relation(fields: [updateId], references: [id])
  kind     String // photo | video
  path     String
}

// A big project can run several stores (e.g. "Block A store", "Main yard") -
// each store belongs to one project, holds its own stock items and has its
// own Stock Manager responsible for it.
model StockStore {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  managerId Int?     // the store's Stock Manager
  manager   User?    @relation("StoreManager", fields: [managerId], references: [id])
  createdAt DateTime @default(now())

  items        StockItem[]
  transfersOut StockTransfer[] @relation("TransferFrom")
  transfersIn  StockTransfer[] @relation("TransferTo")

  @@unique([projectId, name])
  @@index([clientId])
}

// Inter-store requests: a Stock Manager who runs short asks another store
// that HAS the item. On approval the quantity moves between the stores.
model StockTransfer {
  id            Int        @id @default(autoincrement())
  clientId      Int
  client        Client     @relation(fields: [clientId], references: [id])
  itemId        Int
  item          StockItem  @relation(fields: [itemId], references: [id])
  fromStoreId   Int
  fromStore     StockStore @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStoreId     Int
  toStore       StockStore @relation("TransferTo", fields: [toStoreId], references: [id])
  qty           Int
  note          String?
  status        String     @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById Int
  requestedBy   User       @relation(fields: [requestedById], references: [id])
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime   @default(now())

  @@index([clientId])
}

model StockItem {
  id           Int      @id @default(autoincrement())
  clientId     Int
  client       Client   @relation(fields: [clientId], references: [id])
  projectId    Int?     // null = general store (visible to everyone with stock caps)
  project      Project? @relation(fields: [projectId], references: [id])
  storeId      Int?     // which of the project's stores holds it (null = project-wide)
  store        StockStore? @relation(fields: [storeId], references: [id])
  name         String
  category     String   @default("Consumable") // Consumable | Machine
  qty          Int      @default(0)
  unit         String   @default("pcs")
  unitCost     Int      @default(0)
  serial       String?
  lowThreshold Int      @default(0)
  createdAt    DateTime @default(now())

  materials    PhaseMaterial[]
  usedInUpdates UpdateMaterial[]
  issueItems   StockIssueItem[]
  returnItems  StockReturnItem[]
  transfers    StockTransfer[]

  @@index([clientId])
  @@index([projectId])
}

// Proof of how stock was consumed: the Stock Manager (or Senior/Admin) hands
// items to a person - a worker (identified by scanning their card, or picked
// manually) or a team member - and the hand-out is recorded with quantities.
// Stock is deducted at issue time.
model StockIssue {
  id         Int      @id @default(autoincrement())
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id])
  issuedById Int
  issuedBy   User     @relation("stockIssuer", fields: [issuedById], references: [id])
  workerId   Int?     // recipient: a worker...
  worker     Worker?  @relation(fields: [workerId], references: [id])
  userId     Int?     // ...or a team member
  user       User?    @relation("stockReceiver", fields: [userId], references: [id])
  viaCard    Boolean  @default(false) // true when the recipient was identified by card scan
  note       String?
  createdAt  DateTime @default(now())

  items      StockIssueItem[]
  returns    StockReturn[]

  @@index([clientId])
}

model StockIssueItem {
  id           Int        @id @default(autoincrement())
  issueId      Int
  issue        StockIssue @relation(fields: [issueId], references: [id])
  stockItemId  Int
  stockItem    StockItem  @relation(fields: [stockItemId], references: [id])
  nameSnap     String
  unitSnap     String     @default("pcs")
  qty          Int
  unitCostSnap Int
  // Running total handed back against this line (good + damaged). The
  // outstanding quantity - what the person still holds - is qty - returnedQty.
  returnedQty  Int        @default(0)

  returns      StockReturnItem[]

  @@index([issueId])
}

// The other half of an issue: a worker takes 100 bags in the morning and
// brings the unused ones back in the afternoon. Each hand-back is recorded
// against the original issue, so what a person still holds is always known.
// Good items go back into the store's quantity; damaged ones do not - they
// are logged as damaged instead, so stock never counts a broken item as usable.
model StockReturn {
  id           Int      @id @default(autoincrement())
  clientId     Int
  client       Client   @relation(fields: [clientId], references: [id])
  issueId      Int
  issue        StockIssue @relation(fields: [issueId], references: [id])
  receivedById Int      // the Stock Manager / Senior who took the items back
  receivedBy   User     @relation("stockReturnTaker", fields: [receivedById], references: [id])
  workerId     Int?     // who handed them back: a worker...
  worker       Worker?  @relation(fields: [workerId], references: [id])
  userId       Int?     // ...or a team member (mirrors StockIssue)
  user         User?    @relation("stockReturner", fields: [userId], references: [id])
  viaCard      Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())

  items        StockReturnItem[]

  @@index([clientId])
  @@index([issueId])
}

model StockReturnItem {
  id           Int         @id @default(autoincrement())
  returnId     Int
  return       StockReturn @relation(fields: [returnId], references: [id])
  issueItemId  Int
  issueItem    StockIssueItem @relation(fields: [issueItemId], references: [id])
  stockItemId  Int
  stockItem    StockItem   @relation(fields: [stockItemId], references: [id])
  nameSnap     String
  unitSnap     String      @default("pcs")
  qty          Int
  unitCostSnap Int
  condition    String      @default("good") // good = back into stock | damaged = logged as damaged

  @@index([returnId])
}

model StockRequest {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        Client   @relation(fields: [clientId], references: [id])
  projectId     Int?
  project       Project? @relation(fields: [projectId], references: [id])
  itemName      String
  qty           String
  note          String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById Int
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([clientId])
}

model DamagedItem {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])
  name      String
  serial    String?
  note      String?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Message {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  text        String   @db.Text
  attachments Json?
  recipientId Int? // null = whole-company channel; set = private DM to that user
  createdAt   DateTime @default(now())

  @@index([clientId])
}

// Singleton row (id 1) for platform-wide Super Admin settings.
model PlatformSettings {
  id                   Int @id @default(1)
  renewalReminderDays  Int @default(5)
}

// A permanently deleted company takes its own AuditLog rows with it, so the
// deletion would otherwise leave no trace anywhere. This is the platform's
// record of what was destroyed, by whom, and how much of it there was.
model DeletedClient {
  id         Int      @id @default(autoincrement())
  clientId   Int      // the id the company used to have
  company    String
  country    String?
  plan       String?
  status     String?
  createdAt  DateTime @default(now()) // when the deletion happened
  signupAt   DateTime? // when the company had originally signed up
  deletedBy  String   // Super Admin who performed it
  removed    Json?    // row counts per table, for reference
}

model DemoBooking {
  id        Int      @id @default(autoincrement())
  slot      DateTime @unique
  name      String
  company   String?
  email     String
  phone     String?
  teamSize  String?
  interests Json?
  seenAt    DateTime? // when the Super Admin acknowledged the booking popup
  // Demo lifecycle tracking (Super Admin › Demos tab)
  status    String    @default("SCHEDULED") // SCHEDULED | DONE | NO_SHOW | CANCELED
  heldAt    DateTime? // when it was marked DONE
  duration  Int?      // minutes the demo actually took
  note      String?   @db.Text // outcome notes
  createdAt DateTime @default(now())
}

model Folder {
  id         Int      @id @default(autoincrement())
  clientId   Int
  name       String
  system     Boolean  @default(false) // Design, Project Documents - fixed folders
  restricted Boolean  @default(false) // system folders: true = client-only access
  createdAt  DateTime @default(now())

  documents  Document[]

  @@index([clientId])
}

model Document {
  id         Int      @id @default(autoincrement())
  clientId   Int
  folderId   Int?
  folder     Folder?  @relation(fields: [folderId], references: [id])
  name       String
  path       String
  kind       String   @default("file") // image | video | pdf | file
  visibility String   @default("public") // public = company; private = uploader + client
  uploaderId Int
  uploader   User     @relation(fields: [uploaderId], references: [id])
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([folderId])
}

model Worker {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  projectId Int?     // null = works across the whole account
  project   Project? @relation(fields: [projectId], references: [id])
  name      String
  type      String   @default("builder") // builder | helper
  phone     String?
  photo     String?  // optional worker photo (uploads/ filename); initials otherwise
  cardId    String? // RFID/NFC/QR badge id - enrolled once, tapped daily
  dailyRate Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  records   AttendanceRecord[]
  issues    CardIssue[]
  stockIssues StockIssue[]
  stockReturns StockReturn[]

  @@unique([clientId, cardId])
  @@index([clientId])
}

model CardIssue {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  workerId  Int?     // card generated for a worker...
  worker    Worker?  @relation(fields: [workerId], references: [id])
  userId    Int?     // ...or a team member
  user      User?    @relation(fields: [userId], references: [id])
  cardId    String
  issuedBy  String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model AttendanceSession {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  phaseId   Int?
  phase     Phase?   @relation(fields: [phaseId], references: [id])
  date      DateTime // start of the working day
  mode      String   @default("in") // in | out | closed
  paused    Boolean  @default(false) // open but not receiving taps; one live session per project
  openedBy  String
  closedBy  String?
  openedAt  DateTime @default(now())
  closedAt  DateTime?

  records   AttendanceRecord[]

  @@index([clientId])
  @@index([projectId])
}

model AttendanceRecord {
  id         Int               @id @default(autoincrement())
  sessionId  Int
  session    AttendanceSession @relation(fields: [sessionId], references: [id])
  workerId   Int?    // a worker tapping in...
  worker     Worker? @relation(fields: [workerId], references: [id])
  userId     Int?    // ...or a team member (staff attendance - no wage)
  user       User?   @relation(fields: [userId], references: [id])
  clockInAt  DateTime?
  clockOutAt DateTime?
  inMethod   String? // auto | manual
  outMethod  String?
  inBy       String? // 'card' or the recorder's name
  outBy      String?
  rateSnap   Int? // worker's daily rate captured at clock-in - the amount actually owed for this day

  @@unique([sessionId, workerId])
  @@unique([sessionId, userId])
  @@index([sessionId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  userName  String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([clientId])
}
