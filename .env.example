# Copy to .env next to docker-compose.yml and fill in - then: docker compose up -d --build

# Required. DB_PASSWORD is MySQL's root password.
DB_PASSWORD=choose-a-strong-database-password

# Recommended for NEW installs: a scoped database account for the app, so a
# SQL-injection or ORM bug cannot reach beyond the bridge database. DB_USER /
# DB_USER_PASSWORD create it on first boot; DB_APP_USER / DB_APP_PASSWORD tell
# the app to use it. Leave DB_APP_* empty on an EXISTING deployment - the user
# is not created retroactively (DEPLOY.md explains how to add it by hand).
DB_USER=bridge
DB_USER_PASSWORD=choose-a-different-strong-password
DB_APP_USER=
DB_APP_PASSWORD=
# Must be at least 32 characters - the API refuses to start otherwise, because
# a weak or missing secret makes every login token forgeable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=choose-a-long-random-secret-for-login-tokens

# Where the app is reached (used in email links) + published port.
# APP_URL MUST be the real public address: it is what password-reset links point
# at, and it is the origin the API accepts browser calls from.
APP_URL=http://your-server-or-domain:4311
APP_PORT=4311

# Extra browser origins allowed to call the API (comma-separated). Only needed
# when the web app is served from somewhere other than APP_URL.
CORS_ORIGINS=

# Set to 1 when the app runs behind a reverse proxy, so rate limiting sees the
# real client address instead of the proxy's.
TRUST_PROXY=

# Email (optional - leave empty to run without email; messages log to the container)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CMS - Construction Management System <no-reply@yourdomain.com>"
MAIL_REPLY_TO=

# MoMo account subscribers pay into (shown on the Billing page checkout)
MOMO_NUMBER=0788 123 456
MOMO_NAME=Your Company Ltd

# Platform Super Admin, created on first boot. There is no default password -
# this account owns every tenant, so the seed refuses to run without a strong
# one (12+ chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SUPER_EMAIL=admin@yourdomain.com
SUPER_PASSWORD=

# Load the demo dataset (sample projects AND demo logins that share one
# well-known password). Development only - never leave this on for an instance
# anyone else can reach, and run `npm run purge:demo` before going live.
SEED_DEMO=false

# Nightly backups (database + uploads) written to ./backups on the host.
# Copy them off this machine too - a backup on the same disk as the database
# does not survive losing the disk.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
BACKUP_ON_START=false
